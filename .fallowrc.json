{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    // Type-checked against `dist/` by `vp run check:dist`, never imported.
    "test/dist-consumer/index.ts",
    // Worked examples of building specific systems on the library; their
    // tests are under test/examples/.
    "examples/*.ts"
  ],
  // Bins run only by vite.config.ts tasks, which fallow doesn't read.
  "ignoreDependencies": ["@typescript/native", "fallow", "@changesets/changelog-github"],
  // Module-per-mechanism: `Choice` and `TieBreak` are the shared core, and no
  // mechanism imports another.
  "boundaries": {
    "zones": [
      { "name": "choice", "patterns": ["src/Choice.ts"] },
      { "name": "tiebreak", "patterns": ["src/TieBreak.ts"] },
      { "name": "vote", "patterns": ["src/Vote.ts"] },
      { "name": "auction", "patterns": ["src/Auction.ts"] },
      { "name": "draft", "patterns": ["src/Draft.ts"] }
    ],
    "rules": [
      { "from": "choice", "allow": [] },
      { "from": "tiebreak", "allow": [] },
      { "from": "vote", "allow": ["choice", "tiebreak"] },
      { "from": "auction", "allow": ["choice", "tiebreak"] },
      { "from": "draft", "allow": ["choice", "tiebreak"] }
    ]
  },
  "rules": {
    "boundary-violation": "error",
    "unused-dev-dependencies": "error",
    "unused-catalog-entries": "error"
  },
  // CRAP scores need the coverage `vp run test:unit` writes.
  "health": {
    "coverage": "coverage/coverage-final.json"
  },
  "failOnParseError": true
}
