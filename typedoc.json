// The docs gate (`vp run docgen`). TypeDoc renders the API reference for
// everything reachable from the package's one entry point into the gitignored
// `api-docs/`; the validation below, with warnings as errors, is what makes it
// a gate.
{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "api-docs",
  "tsconfig": "tsconfig.json",
  // `vp check` (tsgolint) and the patched `tsc` already type-check `src/`;
  // TypeDoc's own TS 6 pass would only repeat them, over `tests/` too.
  "skipErrorChecking": true,
  // TypeDoc's default list: every export, method and property needs a doc
  // comment, the fields of the schemas and interfaces included.
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Property",
    "Method",
    "Accessor",
    "TypeAlias"
  ],
  // Links that resolve into `effect` (our own, and the ones inherited from
  // Effect's comments on `Schema.TaggedError` statics such as `makeEffect`)
  // point at Effect's API reference, the URL its own README gives.
  "externalSymbolLinkMappings": {
    "effect": { "*": "https://effect.website/docs/v4/api/effect" }
  },
  // The type-level brand of each error class (`Schema.TaggedError`'s second
  // type argument), which has no runtime value to document.
  "intentionallyNotDocumented": [
    "TieBreak.TieUnresolved.brand",
    "TieBreak.TieUnresolved.__type.brand",
    "HareClark.InvalidElection.brand",
    "HareClark.InvalidElection.__type.brand",
    "BondAuction.InvalidTender.brand",
    "BondAuction.InvalidTender.__type.brand",
    "BondAuction.InvalidBid.brand",
    "BondAuction.InvalidBid.__type.brand",
    "AflDraft.InvalidDraft.brand",
    "AflDraft.InvalidDraft.__type.brand",
    "AflDraft.InvalidResponse.brand",
    "AflDraft.InvalidResponse.__type.brand"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "invalidPath": true,
    "rewrittenLink": true,
    "notDocumented": true,
    "unusedMergeModuleWith": true
  },
  "treatWarningsAsErrors": true
}
